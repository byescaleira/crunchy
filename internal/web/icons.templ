package web

// icons.templ holds the Apple TV–style inline-SVG icon set. Each icon is a
// 24×24 (or 32×32 for the brand mark) viewBox glyph drawn with a thin 1.75px
// round stroke in currentColor, so a single icon recolors via text-* utilities
// and scales via width/height classes. The strokes are geometric and clean —
// the SF-style silhouette — not hand-drawn. These are pure presentation: no IDs,
// no JS hooks, no a11y beyond the caller's context.

// iconReel is the brand mark: a clean film reel with sprocket holes and a center
// hub. Used next to the wordmark in the glass top bar.
templ iconReel(class string) {
	<svg class={ class } viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="16" cy="16" r="13"/>
		<circle cx="16" cy="16" r="2.6" fill="currentColor" stroke="none"/>
		<circle cx="16" cy="6.4" r="1.9"/>
		<circle cx="25.6" cy="16" r="1.9"/>
		<circle cx="16" cy="25.6" r="1.9"/>
		<circle cx="6.4" cy="16" r="1.9"/>
	</svg>
}

// iconCrunchy is the Crunchyroll-style brand mark: an orange rounded square with
// a white "winking eye" — a white circle cut by an offset orange circle into a
// crescent. It is a self-contained, offline recreation (not the trademark itself)
// with its own fill colors, so it renders without a text-color utility. Used as
// the project logo next to the wordmark in the glass top bar.
templ iconCrunchy(class string) {
	<svg class={ class } viewBox="0 0 32 32" aria-hidden="true">
		<rect x="1.5" y="1.5" width="29" height="29" rx="9" fill="#FF640C"/>
		<circle cx="16" cy="16" r="9" fill="#FFFFFF"/>
		<circle cx="20" cy="12" r="8.5" fill="#FF640C"/>
	</svg>
}

// iconDownload is a down arrow settling into a tray — the download action.
templ iconDownload(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M12 3.5v10.2M7.9 9.8 12 14.2l4.1-4.4"/>
		<path d="M4.5 16.5v2.9A1.6 1.6 0 0 0 6.1 21h11.8a1.6 1.6 0 0 0 1.6-1.6v-2.9"/>
	</svg>
}

// iconSearch is the magnifying glass for the unified search box.
templ iconSearch(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="10.5" cy="10.5" r="6"/>
		<path d="M15 15l5.2 5.2"/>
	</svg>
}

// iconGear is the settings cog, for the Settings nav use and form affordances.
templ iconGear(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="12" cy="12" r="3.2"/>
		<path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.3 5.3l1.7 1.7M17 17l1.7 1.7M18.7 5.3 17 7M7 17l-1.7 1.7"/>
	</svg>
}

// iconClose is the X for the modal Cancel / close affordances.
templ iconClose(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M6 6l12 12M18 6 6 18"/>
	</svg>
}

// iconCheck is the checkmark for done states and confirmations.
templ iconCheck(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M4.8 12.4l4.6 4.6L19.2 7.2"/>
	</svg>
}

// iconPlay is the playback triangle, for the "View episodes" affordance.
templ iconPlay(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
		<path d="M8 5.6v12.8l11-6.4z"/>
	</svg>
}

// iconCalendar is the release-date glyph next to an episode's air date, matching
// the Crunchyroll episode-card meta line.
templ iconCalendar(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<rect x="3.5" y="5" width="17" height="15.5" rx="2.2"/>
		<path d="M3.5 9.7h17M8 3.2v3.6M16 3.2v3.6"/>
	</svg>
}

// iconSpinner is a clean three-quarter arc that spins while a job is active.
// atv-spin gives it a steady clinical rotation (frozen under reduced-motion).
templ iconSpinner(class string) {
	<svg class={ class + " atv-spin"} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
		<path d="M12 3.2a8.8 8.8 0 1 0 8.8 8.8" stroke-dasharray="38 14"/>
	</svg>
}

// iconCancel is the stop/abort glyph for the per-card Cancel control.
templ iconCancel(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<rect x="6" y="6" width="12" height="12" rx="2"/>
	</svg>
}

// iconTrash is the delete glyph for the per-card Delete control.
templ iconTrash(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M4 7h16M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7M6.5 7l.8 12.2A1.5 1.5 0 0 0 8.8 21h6.4a1.5 1.5 0 0 0 1.5-1.4L17.5 7"/>
	</svg>
}

// iconRestart is the circular-arrow restart glyph for the per-card Restart control.
templ iconRestart(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M5 12a7 7 0 1 0 2-4.9"/>
		<path d="M5 4v3.6h3.6"/>
	</svg>
}

// iconSun is the filled-ray sun shown on the theme toggle when the active theme
// is dark (click to go light). 24×24, currentColor, round stroke.
templ iconSun(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="12" cy="12" r="4"/>
		<path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.3 5.3l1.7 1.7M17 17l1.7 1.7M18.7 5.3 17 7M7 17l-1.7 1.7"/>
	</svg>
}

// iconMoon is the crescent shown on the theme toggle when the active theme is
// light (click to go dark).
templ iconMoon(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"/>
	</svg>
}