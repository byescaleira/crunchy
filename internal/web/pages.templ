package web

import (
	"fmt"

	"crunchyroll-downloader/internal/jobs"
	"crunchyroll-downloader/internal/media"
)

// emptyState is the rubber-hose "now showing" cue for empty panels: a
// hand-drawn clapperboard mascot over a quiet hint line. Used for the no-jobs /
// no-episodes / no-results states (kept to the plan's ≤2 mascot spots: the jobs
// queue and the episodes well).
templ emptyState(msg string) {
	<div class="flex flex-col items-center gap-3 py-8 text-base-content/40">
		@iconClapboard("h-12 w-12")
		<p class="font-mono text-sm text-center max-w-xs">{ msg }</p>
	</div>
}

// SettingsPage renders the etp-rt settings card and a Downloads card for the
// max-concurrent-downloads preference. saved indicates a verified token is on
// file; errText shows a token/transport error from the last save. maxConcurrent
// is the persisted concurrency cap (shown in the Downloads card; it takes effect
// after a restart).
templ SettingsPage(saved bool, errText string, maxConcurrent int) {
	@Layout("Settings", "settings") {
		<div class="max-w-xl flex flex-col gap-4">
			@eyebrow("Settings")
			<div class="card bg-base-100 rh-sticker rounded-box">
				<div class="card-body gap-4">
					<h2 class="font-display uppercase text-xl">etp_rt token</h2>
					<p class="text-sm text-base-content/70">
						Paste your <code class="font-mono text-primary">etp_rt</code> cookie. It stays on this machine
						(127.0.0.1) and is never logged.
					</p>
					<form hx-post="/settings" hx-target="#settings-result" class="flex flex-col gap-3">
						<label class="form-control">
							<span class="label-text mb-1 font-label text-xs uppercase tracking-wider">etp_rt cookie</span>
							<input
								type="password"
								name="etpRt"
								class="input input-bordered rounded-field font-mono"
								placeholder="etp_rt value"
							/>
						</label>
						<button class="btn btn-primary rh-press rounded-field self-start">Save &amp; test token</button>
					</form>
					<div id="settings-result">
						if errText != "" {
							@Alert("error", errText)
						} else if saved {
							@Alert("success", "Token saved and verified.")
						}
					</div>
				</div>
			</div>

			<div class="card bg-base-100 rh-sticker rounded-box">
				<div class="card-body gap-4">
					<h2 class="font-display uppercase text-xl">Downloads</h2>
					<p class="text-sm text-base-content/70">
						How many episodes to download at once. A whole season fans out into one job per
						episode; this caps how many run in parallel. Higher is faster but risks
						rate-limiting. Takes effect after a server restart.
					</p>
					<form hx-post="/settings/downloads" hx-target="#downloads-result" class="flex items-end gap-3">
						<label class="form-control">
							<span class="label-text mb-1 font-label text-xs uppercase tracking-wider">Concurrent downloads</span>
							<input
								type="number"
								name="maxConcurrent"
								min="1"
								max="8"
								value={ fmt.Sprintf("%d", maxConcurrent) }
								class="input input-bordered rounded-field font-mono w-24"
							/>
						</label>
						<button class="btn btn-primary rh-press rounded-field">Save</button>
					</form>
					<div id="downloads-result"></div>
				</div>
			</div>
		</div>
	}
}

// BrowsePage renders the browse panel: one unified search box (paste a series
// URL or type a title — the app tells them apart), a #seasons target that the
// popular grid fills on load and that search/URL results swap into via HTMX, an
// #episodes target for the episode grid, and a #download-queue transmission log
// that self-loads and refreshes when a download is submitted.
templ BrowsePage(popular []media.BrowsePanel, errText string) {
	@Layout("Browse", "browse") {
		<div class="flex flex-col gap-4">
			@eyebrow("Browse")
			<form hx-post="/browse" hx-target="#seasons" hx-swap="innerHTML" class="join">
				<input
					type="text"
					name="q"
					class="input input-bordered join-item rounded-field font-mono w-full"
					placeholder="Paste a series URL or search by title"
				/>
				<button class="btn btn-primary join-item rh-press rounded-field gap-1.5">
					@iconSearch("h-4 w-4")
					<span>Search</span>
				</button>
			</form>

			<div id="seasons" class="flex flex-col gap-2">
				@PopularGrid(popular, errText)
			</div>

			<div>
				@eyebrow("Episodes")
				<div id="episodes" class="mt-2">
					@emptyState("Select a season to list its episodes.")
				</div>
			</div>

			<div>
				@eyebrow("Now downloading")
				<div
					id="download-queue"
					class="mt-2"
					hx-get="/jobs/list"
					hx-trigger="load, refresh"
					hx-target="this"
					hx-swap="innerHTML"
				>
					@emptyState("No jobs yet — start a download from an episode.")
				</div>
			</div>
		</div>
	}
}

// PopularGrid renders the most-popular-anime grid swapped into #seasons on load
// and on an empty search. Empty + no error shows a quiet hint.
templ PopularGrid(panels []media.BrowsePanel, errText string) {
	if errText != "" {
		@Alert("error", errText)
	}
	if len(panels) == 0 && errText == "" {
		<p class="text-sm text-base-content/40 font-mono">No popular anime available right now.</p>
	}
	if len(panels) > 0 {
		@eyebrowInline("Popular now")
		<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3 mt-2">
			for _, p := range panels {
				@seriesResultCard(p.ID, p.Title, p.SlugTitle, p.Images, p.SeriesLaunchYear)
			}
		</div>
	}
}

// SearchResults renders a title-search result grid swapped into #seasons.
templ SearchResults(hits []media.SearchHit, errText string) {
	if errText != "" {
		@Alert("error", errText)
	}
	if len(hits) == 0 && errText == "" {
		<p class="text-sm text-base-content/40 font-mono">No results.</p>
	}
	if len(hits) > 0 {
		@eyebrowInline("Search results")
		<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3 mt-2">
			for _, h := range hits {
				@seriesResultCard(h.ID, h.Title, h.SlugTitle, h.Images, 0)
			}
		</div>
	}
}

// seriesResultCard renders one series as a compact TV-guide card: a landscape
// key-art banner (poster_wide, falling back to the portrait poster), the title,
// a launch-year badge, and a "List seasons" button. The button posts the
// reconstructed /series/<id>/<slug> URL as the unified `q` field, so it reuses
// the existing URL drill-down (seasons list + series hero) without a separate
// code path. Landscape art keeps the banner short so the grid reads as cards,
// not full-screen posters.
templ seriesResultCard(id, title, slug string, img media.Images, year int) {
	{{
		var src string
		if im, ok := media.BestImage(img.PosterWide); ok && im.Source != "" {
			src = im.Source
		} else if im, ok := media.BestImage(img.PosterTall); ok && im.Source != "" {
			src = im.Source
		}
	}}
	<div class="card bg-base-100 rh-sticker rounded-box overflow-hidden">
		<div class="aspect-video bg-base-300/50 overflow-hidden">
			if src != "" {
				<img src={ src } alt={ title } class="w-full h-full object-cover" loading="lazy"/>
			} else {
				<div class="w-full h-full flex items-center justify-center">
					<span class="font-mono text-xs text-base-content/30">no art</span>
				</div>
			}
		</div>
		<div class="card-body gap-1.5 p-3">
			<h3 class="font-display text-sm leading-tight line-clamp-2" title={ title }>{ title }</h3>
			<div class="flex flex-wrap items-center gap-1">
				if year != 0 {
					<span class="badge badge-ghost badge-sm font-mono">{ year }</span>
				}
			</div>
			<div class="mt-1">
				<button
					class="btn btn-primary btn-sm rh-press rounded-field w-full"
					hx-post="/browse"
					hx-target="#seasons"
					hx-swap="innerHTML"
					hx-vals={ fmt.Sprintf("{\"q\":%q}", "https://www.crunchyroll.com/series/"+id+"/"+slug) }
				>
					List seasons
				</button>
			</div>
		</div>
	</div>
}

// BrowseSeriesResult is the HTMX partial swapped into #seasons after a /browse
// POST: the series hero (key art + title + meta + Download-series), followed by
// the season "program log" with its Download-season buttons.
templ BrowseSeriesResult(series media.Series, seriesID string, seasons []media.Season, errText string) {
	if errText != "" {
		@Alert("error", errText)
	}
	@seriesHero(series, seriesID)
	@SeasonsList(seasons, seriesID, "")
}

// SeasonsList renders the "Program log" header and the season rows. seriesID is
// carried so the hero's Download-series button can render above the log; empty
// before the user lists a series.
templ SeasonsList(seasons []media.Season, seriesID, errText string) {
	if errText != "" {
		@Alert("error", errText)
	}
	if len(seasons) == 0 && errText == "" {
		<p class="text-sm text-base-content/40 font-mono">No seasons yet — paste a series URL above.</p>
	}
	if len(seasons) > 0 {
		<div class="card bg-base-100 rh-sticker rounded-box">
			<div class="flex items-center justify-between px-4 pt-3 pb-2">
				@eyebrowInline("Program log")
				<span class="font-mono text-xs text-base-content/40">{ fmt.Sprintf("%v seasons", len(seasons)) }</span>
			</div>
			<div class="px-4 pb-2">
				for _, s := range seasons {
					@seasonCard(s)
				}
			</div>
		</div>
	}
}

// EpisodesTable renders the episode grid (one EpisodeCard per episode) swapped
// into #episodes when a season is selected. Named EpisodesTable for historic
// continuity with the route handler.
templ EpisodesTable(episodes []media.SeasonEpisode, errText string) {
	if errText != "" {
		@Alert("error", errText)
	}
	if len(episodes) == 0 && errText == "" {
		<p class="text-sm text-base-content/40 font-mono">No episodes found.</p>
	}
	if len(episodes) > 0 {
		<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
			for _, ep := range episodes {
				@episodeCard(ep)
			}
		</div>
	}
}

// DownloadForm is the body of the download-options modal. It is loaded into
// #download-modal-content by GET /downloads/new, and posts to /downloads. On a
// validation error the server re-renders this same template with errs (HTTP 422)
// so the dialog stays open and shows the errors; on success it returns an empty
// body + an HX-Trigger that closes the modal and refreshes the queue.
templ DownloadForm(opts DownloadFormOpts, errs map[string]string) {
	<form
		hx-post="/downloads"
		hx-target="#download-modal-content"
		hx-swap="innerHTML"
		class="flex flex-col gap-4"
	>
		<input type="hidden" name="kind" value={ opts.Kind }/>
		<input type="hidden" name="id" value={ opts.ID }/>
		<div class="flex items-start justify-between gap-2">
			<h3 class="font-display uppercase text-lg leading-tight">{ opts.Summary }</h3>
			<button
				class="btn btn-ghost btn-sm btn-square rh-press rounded-field"
				type="button"
				onclick="document.getElementById('download-modal').close()"
				aria-label="Close"
			>
				@iconClose("h-4 w-4")
			</button>
		</div>
		if errs["_"] != "" {
			@Alert("error", errs["_"])
		}
		<div class="grid grid-cols-2 gap-3">
			<label class="form-control">
				<span class="label-text mb-1 font-label text-xs uppercase tracking-wider">Video quality</span>
				<select name="videoQuality" class="select select-bordered rounded-field">
					<option value="1080p" selected?={ opts.VideoQuality == "1080p" }>1080p</option>
					<option value="720p" selected?={ opts.VideoQuality == "720p" }>720p</option>
					<option value="480p" selected?={ opts.VideoQuality == "480p" }>480p</option>
					<option value="360p" selected?={ opts.VideoQuality == "360p" }>360p</option>
				</select>
			</label>
			<label class="form-control">
				<span class="label-text mb-1 font-label text-xs uppercase tracking-wider">Audio quality</span>
				<select name="audioQuality" class="select select-bordered rounded-field">
					<option value="192k" selected?={ opts.AudioQuality == "192k" }>192k</option>
					<option value="128k" selected?={ opts.AudioQuality == "128k" }>128k</option>
					<option value="96k" selected?={ opts.AudioQuality == "96k" }>96k</option>
				</select>
			</label>
		</div>
		<div class="form-control">
			<span class="label-text mb-1 font-label text-xs uppercase tracking-wider">Audio languages</span>
			<div class="flex flex-wrap gap-1.5">
				for _, l := range commonAudioLocales {
					<label class="label cursor-pointer gap-2 rh-sticker-flat rounded-field px-2.5 py-1.5">
						<input
							type="checkbox"
							name="audioLangs"
							value={ l }
							class="checkbox checkbox-primary checkbox-sm"
							checked?={ containsString(opts.SelectedAudio, l) }
						/>
						<span class="label-text font-mono text-xs">{ l }</span>
					</label>
				}
			</div>
			if errs["audio"] != "" {
				<p class="text-error text-xs mt-1">{ errs["audio"] }</p>
			}
		</div>
		<div class="form-control">
			<span class="label-text mb-1 font-label text-xs uppercase tracking-wider">Subtitle languages</span>
			<div class="flex flex-wrap gap-1.5">
				for _, l := range commonSubLocales {
					<label class="label cursor-pointer gap-2 rh-sticker-flat rounded-field px-2.5 py-1.5">
						<input
							type="checkbox"
							name="subsLangs"
							value={ l }
							class="checkbox checkbox-primary checkbox-sm"
							checked?={ containsString(opts.SelectedSubs, l) }
						/>
						<span class="label-text font-mono text-xs">{ l }</span>
					</label>
				}
			</div>
		</div>
		<div class="grid grid-cols-2 gap-3">
			<label class="form-control">
				<span class="label-text mb-1 font-label text-xs uppercase tracking-wider">File format</span>
				<select name="format" class="select select-bordered rounded-field">
					<option value="mkv" selected?={ opts.Format == "mkv" }>.mkv</option>
					<option value="mp4" selected?={ opts.Format == "mp4" }>.mp4</option>
				</select>
			</label>
			<label class="form-control">
				<span class="label-text mb-1 font-label text-xs uppercase tracking-wider">Output directory</span>
				<input
					type="text"
					name="outputDir"
					class="input input-bordered rounded-field font-mono"
					value={ opts.OutputDir }
					placeholder="."
				/>
			</label>
		</div>
		<div class="modal-action">
			<button class="btn btn-primary rh-press rounded-field gap-1.5">
				@iconDownload("h-4 w-4")
				<span>Download</span>
			</button>
		</div>
	</form>
}

// JobsPage renders the jobs panel: a "Now downloading" header with a refresh
// button, plus the current job cards. The live updates are driven by the single
// multiplexed /jobs/events stream wired in Layout (one EventSource for the whole
// page), so this page carries no per-card script.
templ JobsPage(js []*jobs.Job) {
	@Layout("Jobs", "jobs") {
		<div class="flex flex-col gap-3">
			<div class="flex items-center justify-between">
				@eyebrowInline("Now downloading")
				<button class="btn btn-ghost btn-sm rh-press rounded-field gap-1.5" hx-get="/jobs/list" hx-target="#jobs-list">
					@iconGear("h-4 w-4")
					<span>Refresh</span>
				</button>
			</div>
			<div id="jobs-list" class="card bg-base-100 rh-sticker rounded-box px-4">
				@JobsList(js)
			</div>
		</div>
	}
}

// JobsList is the HTMX partial swapped into #jobs-list (and #download-queue) by
// /jobs/list. Jobs of one season/series share a GroupID (enqueued contiguously),
// so a section header (the GroupLabel) is rendered whenever the GroupID changes
// between consecutive jobs. Empty state is an invitation to act.
templ JobsList(js []*jobs.Job) {
	if len(js) == 0 {
		@emptyState("No jobs yet — start a download to see it here.")
	}
	for _, row := range jobsRows(js) {
		if row.Group != "" {
			<div class="flex items-center gap-2 pt-3 first:pt-0.5">
				<span class="font-label text-xs uppercase tracking-wider text-primary/80">{ row.Group }</span>
			</div>
		}
		if row.Job != nil {
			@jobCard(row.Job)
		}
	}
}

// jobRow is one row in the jobs list: either a group header (Group != "") or a
// job card (Job != nil).
type jobRow struct {
	Group string // group label to render as a section header; empty if this is a job card
	Job   *jobs.Job
}

// jobsRows flattens the job list into render rows, inserting a group header
// whenever the GroupID changes between consecutive jobs. Enqueue order keeps a
// season/series's episodes contiguous, so this yields one header per season.
func jobsRows(js []*jobs.Job) []jobRow {
	var rows []jobRow
	prev := ""
	for _, j := range js {
		if j.GroupID != "" && j.GroupID != prev {
			prev = j.GroupID
			label := j.GroupLabel
			if label == "" {
				label = "Downloads"
			}
			rows = append(rows, jobRow{Group: label})
		}
		rows = append(rows, jobRow{Job: j})
	}
	return rows
}