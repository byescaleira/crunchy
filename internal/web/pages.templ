package web

import (
	"fmt"

	"crunchyroll-downloader/internal/jobs"
	"crunchyroll-downloader/internal/media"
)

// SettingsPage renders the etp-rt settings card. saved indicates a verified
// token is on file; errText shows a token/transport error from the last save.
templ SettingsPage(saved bool, errText string) {
	@Layout("Settings", "settings") {
		<div class="max-w-xl">
			@eyebrow("Settings")
			<div class="card bg-base-100 border border-base-300 rounded-box mt-2">
				<div class="card-body gap-4">
					<h2 class="font-display uppercase text-xl">etp_rt token</h2>
					<p class="text-sm text-base-content/70">
						Paste your <code class="font-mono text-primary">etp_rt</code> cookie. It stays on this machine
						(127.0.0.1) and is never logged.
					</p>
					<form hx-post="/settings" hx-target="#settings-result" class="flex flex-col gap-3">
						<label class="form-control">
							<span class="label-text mb-1 font-mono text-xs uppercase tracking-wider">etp_rt cookie</span>
							<input
								type="password"
								name="etpRt"
								class="input input-bordered rounded-field font-mono"
								placeholder="etp_rt value"
							/>
						</label>
						<button class="btn btn-primary rounded-field self-start">Save &amp; test token</button>
					</form>
					<div id="settings-result">
						if errText != "" {
							@Alert("error", errText)
						} else if saved {
							@Alert("success", "Token saved and verified.")
						}
					</div>
				</div>
			</div>
		</div>
	}
}

// BrowsePage renders the browse panel: a compact series-URL form, a #seasons
// target that the series hero + season log fill via HTMX, an #episodes target
// for the episode grid, and a #download-queue transmission log that self-loads
// and refreshes when a download is submitted.
templ BrowsePage(seasons []media.Season, seriesURL string, errText string) {
	@Layout("Browse", "browse") {
		<div class="flex flex-col gap-4">
			@eyebrow("Browse a series")
			<form hx-post="/browse" hx-target="#seasons" hx-swap="innerHTML" class="join">
				<input
					type="text"
					name="url"
					class="input input-bordered join-item rounded-field font-mono w-full"
					placeholder="https://www.crunchyroll.com/series/..."
					value={ seriesURL }
				/>
				<button class="btn btn-primary join-item rounded-field font-display uppercase tracking-wider">List seasons</button>
			</form>

			<div id="seasons" class="flex flex-col gap-2">
				if errText != "" {
					@Alert("error", errText)
				}
				<p class="text-sm text-base-content/40 font-mono">Paste a series URL to load its seasons.</p>
			</div>

			<div>
				@eyebrow("Episodes")
				<div id="episodes" class="mt-2">
					<p class="text-sm text-base-content/40 font-mono">Select a season to list its episodes.</p>
				</div>
			</div>

			<div>
				@eyebrow("Now downloading")
				<div
					id="download-queue"
					class="mt-2"
					hx-get="/jobs/list"
					hx-trigger="load, refresh"
					hx-target="this"
					hx-swap="innerHTML"
				>
					<p class="text-sm text-base-content/40 font-mono">No jobs yet — start a download from an episode.</p>
				</div>
			</div>
		</div>
	}
}

// BrowseSeriesResult is the HTMX partial swapped into #seasons after a /browse
// POST: the series hero (key art + title + meta + Download-series), followed by
// the season "program log" with its Download-season buttons.
templ BrowseSeriesResult(series media.Series, seriesID string, seasons []media.Season, errText string) {
	if errText != "" {
		@Alert("error", errText)
	}
	@seriesHero(series, seriesID)
	@SeasonsList(seasons, seriesID, "")
}

// SeasonsList renders the "Program log" header and the season rows. seriesID is
// carried so the hero's Download-series button can render above the log; empty
// before the user lists a series.
templ SeasonsList(seasons []media.Season, seriesID, errText string) {
	if errText != "" {
		@Alert("error", errText)
	}
	if len(seasons) == 0 && errText == "" {
		<p class="text-sm text-base-content/40 font-mono">No seasons yet — paste a series URL above.</p>
	}
	if len(seasons) > 0 {
		<div class="card bg-base-100 border border-base-300 rounded-box">
			<div class="flex items-center justify-between px-4 pt-3 pb-2">
				@eyebrowInline("Program log")
				<span class="font-mono text-xs text-base-content/40">{ fmt.Sprintf("%v seasons", len(seasons)) }</span>
			</div>
			<div class="px-4 pb-2">
				for _, s := range seasons {
					@seasonCard(s)
				}
			</div>
		</div>
	}
}

// EpisodesTable renders the episode grid (one EpisodeCard per episode) swapped
// into #episodes when a season is selected. Named EpisodesTable for historic
// continuity with the route handler.
templ EpisodesTable(episodes []media.SeasonEpisode, errText string) {
	if errText != "" {
		@Alert("error", errText)
	}
	if len(episodes) == 0 && errText == "" {
		<p class="text-sm text-base-content/40 font-mono">No episodes found.</p>
	}
	if len(episodes) > 0 {
		<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
			for _, ep := range episodes {
				@episodeCard(ep)
			}
		</div>
	}
}

// DownloadForm is the body of the download-options modal. It is loaded into
// #download-modal-content by GET /downloads/new, and posts to /downloads. On a
// validation error the server re-renders this same template with errs (HTTP 422)
// so the dialog stays open and shows the errors; on success it returns an empty
// body + an HX-Trigger that closes the modal and refreshes the queue.
templ DownloadForm(opts DownloadFormOpts, errs map[string]string) {
	<form
		hx-post="/downloads"
		hx-target="#download-modal-content"
		hx-swap="innerHTML"
		class="flex flex-col gap-4"
	>
		<input type="hidden" name="kind" value={ opts.Kind }/>
		<input type="hidden" name="id" value={ opts.ID }/>
		<div class="flex items-start justify-between gap-2">
			<h3 class="font-display uppercase text-lg leading-tight">{ opts.Summary }</h3>
		</div>
		if errs["_"] != "" {
			@Alert("error", errs["_"])
		}
		<div class="grid grid-cols-2 gap-3">
			<label class="form-control">
				<span class="label-text mb-1 font-mono text-xs uppercase tracking-wider">Video quality</span>
				<select name="videoQuality" class="select select-bordered rounded-field">
					<option value="1080p" selected?={ opts.VideoQuality == "1080p" }>1080p</option>
					<option value="720p" selected?={ opts.VideoQuality == "720p" }>720p</option>
					<option value="480p" selected?={ opts.VideoQuality == "480p" }>480p</option>
					<option value="360p" selected?={ opts.VideoQuality == "360p" }>360p</option>
				</select>
			</label>
			<label class="form-control">
				<span class="label-text mb-1 font-mono text-xs uppercase tracking-wider">Audio quality</span>
				<select name="audioQuality" class="select select-bordered rounded-field">
					<option value="192k" selected?={ opts.AudioQuality == "192k" }>192k</option>
					<option value="128k" selected?={ opts.AudioQuality == "128k" }>128k</option>
					<option value="96k" selected?={ opts.AudioQuality == "96k" }>96k</option>
				</select>
			</label>
		</div>
		<div class="form-control">
			<span class="label-text mb-1 font-mono text-xs uppercase tracking-wider">Audio languages</span>
			<div class="flex flex-wrap gap-1.5">
				for _, l := range commonAudioLocales {
					<label class="label cursor-pointer gap-2 border border-base-300 rounded-field px-2.5 py-1.5">
						<input
							type="checkbox"
							name="audioLangs"
							value={ l }
							class="checkbox checkbox-primary checkbox-sm"
							checked?={ containsString(opts.SelectedAudio, l) }
						/>
						<span class="label-text font-mono text-xs">{ l }</span>
					</label>
				}
			</div>
			if errs["audio"] != "" {
				<p class="text-error text-xs mt-1">{ errs["audio"] }</p>
			}
		</div>
		<div class="form-control">
			<span class="label-text mb-1 font-mono text-xs uppercase tracking-wider">Subtitle languages</span>
			<div class="flex flex-wrap gap-1.5">
				for _, l := range commonSubLocales {
					<label class="label cursor-pointer gap-2 border border-base-300 rounded-field px-2.5 py-1.5">
						<input
							type="checkbox"
							name="subsLangs"
							value={ l }
							class="checkbox checkbox-primary checkbox-sm"
							checked?={ containsString(opts.SelectedSubs, l) }
						/>
						<span class="label-text font-mono text-xs">{ l }</span>
					</label>
				}
			</div>
		</div>
		<div class="grid grid-cols-2 gap-3">
			<label class="form-control">
				<span class="label-text mb-1 font-mono text-xs uppercase tracking-wider">File format</span>
				<select name="format" class="select select-bordered rounded-field">
					<option value="mkv" selected?={ opts.Format == "mkv" }>.mkv</option>
					<option value="mp4" selected?={ opts.Format == "mp4" }>.mp4</option>
				</select>
			</label>
			<label class="form-control">
				<span class="label-text mb-1 font-mono text-xs uppercase tracking-wider">Output directory</span>
				<input
					type="text"
					name="outputDir"
					class="input input-bordered rounded-field font-mono"
					value={ opts.OutputDir }
					placeholder="."
				/>
			</label>
		</div>
		<div class="modal-action">
			<button class="btn btn-ghost rounded-field" type="button" onclick="document.getElementById('download-modal').close()">
				Cancel
			</button>
			<button class="btn btn-primary rounded-field font-display uppercase tracking-wider">Download</button>
		</div>
	</form>
}

// JobsPage renders the jobs panel: a "Now downloading" transmission log with a
// refresh button, plus the current job cards. The script wires each card's SSE
// stream to its progress bar, status badge, status dot (the pulsing signature),
// and error line.
templ JobsPage(js []*jobs.Job) {
	@Layout("Jobs", "jobs") {
		<div class="flex flex-col gap-3">
			<div class="flex items-center justify-between">
				@eyebrowInline("Now downloading")
				<button class="btn btn-ghost btn-sm rounded-field font-mono" hx-get="/jobs/list" hx-target="#jobs-list">Refresh</button>
			</div>
			<div id="jobs-list" class="card bg-base-100 border border-base-300 rounded-box px-4">
				@JobsList(js)
			</div>
		</div>
		<script>
			(function () {
				var dotColor = {
					queued: "bg-base-content/30",
					downloading: "bg-primary",
					muxing: "bg-primary",
					done: "bg-success",
					error: "bg-error"
				};
				document.querySelectorAll("[data-job-sse]").forEach(function (card) {
					var id = card.getAttribute("data-job-sse");
					var es = new EventSource("/jobs/" + id + "/events");
					es.addEventListener("segment", function (e) {
						var d = JSON.parse(e.data);
						var box = document.getElementById("job-" + id + "-progress");
						var bar = box && box.querySelector("progress");
						if (bar && d.total > 0) {
							bar.value = (d.done * 100) / d.total;
						}
					});
					es.addEventListener("status", function (e) {
						var d = JSON.parse(e.data);
						var badge = document.getElementById("job-" + id + "-status");
						if (badge) {
							badge.textContent = d.status;
							badge.className = "badge " + ({
								queued: "badge-ghost",
								downloading: "badge-warning",
								muxing: "badge-info",
								done: "badge-success",
								error: "badge-error"
							}[d.status] || "badge-ghost") + " badge-sm font-mono shrink-0";
						}
						var dot = document.getElementById("job-" + id + "-dot");
						if (dot) {
							dot.className = "inline-block h-2 w-2 rounded-full shrink-0 " + (dotColor[d.status] || "bg-base-content/30") + ((d.status === "downloading" || d.status === "muxing") ? " crdl-dot" : "");
						}
						if (d.status === "error") {
							var err = document.getElementById("job-" + id + "-error");
							if (err && d.message) {
								err.innerHTML = '<div class="text-xs text-error font-mono break-all"></div>';
								err.firstChild.textContent = d.message;
							}
						}
					});
					es.addEventListener("done", function () {
						es.close();
					});
					es.addEventListener("error", function () {
						es.close();
					});
				});
			})();
		</script>
	}
}

// JobsList is the HTMX partial swapped into #jobs-list (and #download-queue) by
// /jobs/list. Empty state is an invitation to act.
templ JobsList(js []*jobs.Job) {
	if len(js) == 0 {
		<p class="text-sm text-base-content/40 font-mono py-3">No jobs yet — start a download to see it here.</p>
	}
	for _, j := range js {
		@jobCard(j)
	}
}