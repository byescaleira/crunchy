package web

import (
	"fmt"

	"crunchyroll-downloader/internal/jobs"
	"crunchyroll-downloader/internal/media"
)

// emptyState is the quiet centered hint for empty panels (no jobs / no episodes /
// no results). No mascot — Apple TV keeps empty states minimal and textual.
templ emptyState(msg string) {
	<div class="flex flex-col items-center gap-2 py-10 text-white/35">
		<p class="text-sm text-center max-w-xs">{ msg }</p>
	</div>
}

// SettingsPage renders the etp-rt settings card and a Downloads card for the
// max-concurrent-downloads preference. saved indicates a verified token is on
// file; errText shows a token/transport error from the last save. maxConcurrent
// is the persisted concurrency cap (shown in the Downloads card; it takes effect
// after a restart).
templ SettingsPage(saved bool, errText string, maxConcurrent int) {
	@Layout("Settings", "settings") {
		<div class="max-w-xl flex flex-col gap-4">
			@eyebrow("Settings")
			<div class="atv-card rounded-box p-6 flex flex-col gap-4">
				<h2 class="font-display text-xl font-semibold">etp_rt token</h2>
				<p class="text-sm text-white/60">
					Paste your <code class="font-mono text-primary">etp_rt</code> cookie. It stays on this machine
					(127.0.0.1) and is never logged.
				</p>
				<button
					class="btn btn-outline rounded-full gap-1.5 self-start"
					hx-post="/settings/find-cookies"
					hx-target="#settings-result"
					hx-disabled-elt="this"
				>
					@iconSearch("h-4 w-4")
					<span>Find token in my browser</span>
				</button>
				<p class="text-xs text-white/40">
					Scans Chrome, Brave, Edge, Arc, Firefox, and Safari for the etp_rt cookie. Log in to
					crunchyroll.com in your browser first, then click Find — it's also the refresh.
				</p>
				<form hx-post="/settings" hx-target="#settings-result" class="flex flex-col gap-3">
					<label class="form-control">
						<span class="label-text mb-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-white/45">etp_rt cookie</span>
						<input
							type="password"
							name="etpRt"
							class="input input-bordered rounded-field font-mono bg-base-200 border-white/10"
							placeholder="etp_rt value"
						/>
					</label>
					<button class="btn btn-primary rounded-full self-start">Save &amp; test token</button>
				</form>
				<div id="settings-result">
					if errText != "" {
						@Alert("error", errText)
					} else if saved {
						@Alert("success", "Token saved and verified.")
					}
				</div>
			</div>

			<div class="atv-card rounded-box p-6 flex flex-col gap-4">
				<h2 class="font-display text-xl font-semibold">Downloads</h2>
				<p class="text-sm text-white/60">
					How many episodes to download at once. A whole season fans out into one job per
					episode; this caps how many run in parallel. Higher is faster but risks
					rate-limiting. Takes effect after a server restart.
				</p>
				<form hx-post="/settings/downloads" hx-target="#downloads-result" class="flex items-end gap-3">
					<label class="form-control">
						<span class="label-text mb-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-white/45">Concurrent downloads</span>
						<input
							type="number"
							name="maxConcurrent"
							min="1"
							max="8"
							value={ fmt.Sprintf("%d", maxConcurrent) }
							class="input input-bordered rounded-field font-mono bg-base-200 border-white/10 w-24"
						/>
					</label>
					<button class="btn btn-primary rounded-full">Save</button>
				</form>
				<div id="downloads-result"></div>
			</div>
		</div>
	}
}

// BrowsePage renders the discovery surface: a curated genre rail and a grid of
// series cards. The search box lives in the capsule navbar (not in the body), so
// this page carries no search form — it just renders whatever the query
// resolved to (popular / a genre / search results). Series cards link to
// /series/{id}; the download queue lives on the Jobs page, not here.
templ BrowsePage(view BrowseView) {
	@Layout("Browse", "browse") {
		<div class="flex flex-col gap-5">
			@eyebrow("Browse")
			@categoryRail(view.ActiveCat)
			if view.ErrText != "" {
				@Alert("error", view.ErrText)
			}
			if view.Mode == BrowseSearch {
				@eyebrowInline("Search results")
				if len(view.Hits) == 0 && view.ErrText == "" {
					<p class="text-sm text-white/40 font-mono mt-3">{ fmt.Sprintf("No results for %q.", view.Query) }</p>
				}
				if len(view.Hits) > 0 {
					<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5 mt-4">
						for _, h := range view.Hits {
							@seriesResultCard(h.ID, h.Title, h.SlugTitle, h.Images, 0)
						}
					</div>
				}
			}
			if view.Mode == BrowseCategory {
				@eyebrowInline(media.GenreLabel(view.ActiveCat))
				if len(view.Panels) == 0 && view.ErrText == "" {
					<p class="text-sm text-white/40 font-mono mt-3">No series in this category right now.</p>
				}
				if len(view.Panels) > 0 {
					<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5 mt-4">
						for _, p := range view.Panels {
							@seriesResultCard(p.ID, p.Title, p.SlugTitle, p.Images, p.SeriesLaunchYear)
						}
					</div>
				}
			}
			if view.Mode == BrowsePopular {
				@eyebrowInline("Popular now")
				if len(view.Panels) == 0 && view.ErrText == "" {
					<p class="text-sm text-white/40 font-mono mt-3">No popular anime available right now.</p>
				}
				if len(view.Panels) > 0 {
					<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5 mt-4">
						for _, p := range view.Panels {
							@seriesResultCard(p.ID, p.Title, p.SlugTitle, p.Images, p.SeriesLaunchYear)
						}
					</div>
				}
			}
		</div>
	}
}

// SeriesDetailPage is the full series screen reached by clicking a browse card
// (or pasting a series URL into the navbar search): the cinematic hero with key
// art + title + meta + Download-series, the seasons list with per-season View /
// Download buttons, and an #episodes target a season's View fills via HTMX.
// The download queue is not shown here — it lives on the Jobs page.
templ SeriesDetailPage(series media.Series, seriesID string, seasons []media.Season, errText string) {
	@Layout(seriesTitleOrBrowse(series), "browse") {
		<div class="flex flex-col gap-5">
			<a class="inline-flex items-center gap-1.5 text-sm text-white/55 hover:text-white transition-colors" href="/browse">
				@iconPlay("h-3.5 w-3.5 rotate-180 text-white/55")
				<span>Browse</span>
			</a>
			@seriesHero(series, seriesID)
			@SeasonsList(seasons, seriesID, errText)
			<div>
				@eyebrow("Episodes")
				<div id="episodes" class="mt-3" data-series-id={ seriesID }>
					@emptyState("Select a season to list its episodes.")
				</div>
			</div>
		</div>
	}
}

// seriesTitleOrBrowse returns the series title for the page <title>, falling
// back to "Browse" when the series fetch failed (no title captured).
func seriesTitleOrBrowse(series media.Series) string {
	if series.Title != "" {
		return series.Title
	}
	return "Browse"
}

// seriesResultCard renders one series as a miniature of the series-detail hero:
// a landscape (16:9) key-art backdrop (PosterWide, falling back to PosterTall)
// with the bottom-up atv-hero-scrim, then a "Series" eyebrow + title + year pill
// overlaid at the bottom — the same composition as seriesHero, scaled down for
// the grid. The whole card is a link to the series detail page (/series/{id}),
// so Browse stays a pure discovery surface (popular + categories).
templ seriesResultCard(id, title, slug string, img media.Images, year int) {
	{{
		var src string
		if im, ok := media.BestImage(img.PosterWide); ok && im.Source != "" {
			src = im.Source
		} else if im, ok := media.BestImage(img.PosterTall); ok && im.Source != "" {
			src = im.Source
		}
	}}
	<a
		class="group atv-card atv-lift relative block w-full aspect-video rounded-box overflow-hidden text-left"
		href={ "/series/" + id }
		title={ title }
	>
		if src != "" {
			<img
				src={ src }
				alt={ title }
				class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 ease-out group-hover:scale-105"
				loading="lazy"
			/>
		} else {
			<div class="absolute inset-0 bg-base-300 flex items-center justify-center">
				<span class="font-mono text-xs text-white/25">no art</span>
			</div>
		}
		<div class="absolute inset-0 atv-hero-scrim pointer-events-none"></div>
		<div class="absolute bottom-0 inset-x-0 p-3 md:p-4 flex flex-col gap-1.5 pointer-events-none">
			<span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-white/70">Series</span>
			<h3 class="font-display text-sm md:text-base font-semibold leading-tight line-clamp-2 text-white drop-shadow-lg">{ title }</h3>
			if year != 0 {
				<span class="self-start px-2 py-0.5 rounded-full text-[11px] font-medium bg-white/15 text-white backdrop-blur-sm">{ year }</span>
			}
		</div>
	</a>
}

// BrowseMode is which grid the Browse page is showing.
type BrowseMode int

const (
	BrowsePopular  BrowseMode = iota // the popular grid (no query)
	BrowseCategory                  // a genre filter (?cat=<slug>)
	BrowseSearch                     // title-search results (?q=<title>)
)

// BrowseView is the view-model for the Browse page. Mode selects which grid to
// render; Panels feeds the popular/category grids, Hits feeds the search grid,
// ActiveCat highlights a genre pill, Query is the search term (for the empty
// message), and ErrText surfaces a transport/config error (never the token).
type BrowseView struct {
	Mode      BrowseMode
	Panels    []media.BrowsePanel
	Hits      []media.SearchHit
	ActiveCat string
	Query     string
	ErrText   string
}

// categoryRail is the curated genre filter row above the grid: an "All" pill
// plus one pill per media.BrowseGenres entry. Selecting a genre navigates to
// /browse?cat=<slug> (a GET, so it's a plain shareable link). The active pill
// gets a solid primary fill; the rest are quiet off-white.
templ categoryRail(activeCat string) {
	<div class="flex flex-wrap items-center gap-2">
		@categoryPill("All", "/browse", activeCat == "")
		for _, g := range media.BrowseGenres {
			@categoryPill(g.Label, "/browse?cat="+g.Slug, activeCat == g.Slug)
		}
	</div>
}

// categoryPill is one pill in the genre rail. active gets a solid primary fill.
templ categoryPill(label, href string, active bool) {
	if active {
		<a class="px-3.5 py-1.5 text-sm font-medium text-primary-content bg-primary rounded-full shadow-lg shadow-primary/30" href={ href }>{ label }</a>
	} else {
		<a class="px-3.5 py-1.5 text-sm font-medium text-white/55 hover:text-white rounded-full bg-white/5 hover:bg-white/10 border border-white/10 transition-colors" href={ href }>{ label }</a>
	}
}

// SeasonsList renders the seasons header and the season rows. seriesID is
// carried so the hero's Download-series button can render above the list; empty
// before the user lists a series.
templ SeasonsList(seasons []media.Season, seriesID, errText string) {
	if errText != "" {
		@Alert("error", errText)
	}
	if len(seasons) == 0 && errText == "" {
		<p class="text-sm text-white/40 font-mono">No seasons yet — paste a series URL above.</p>
	}
	if len(seasons) > 0 {
		<div class="atv-card rounded-box">
			<div class="flex items-center justify-between px-5 pt-4 pb-2">
				@eyebrowInline("Seasons")
				<span class="font-mono text-xs text-white/40">{ fmt.Sprintf("%v seasons", len(seasons)) }</span>
			</div>
			<div class="px-5 pb-3">
				for _, s := range seasons {
					@seasonCard(s)
				}
			</div>
		</div>
	}
}

// EpisodesTable renders the episode grid (one EpisodeCard per episode) swapped
// into #episodes when a season is selected. Named EpisodesTable for historic
// continuity with the route handler.
templ EpisodesTable(episodes []media.SeasonEpisode, errText string) {
	if errText != "" {
		@Alert("error", errText)
	}
	if len(episodes) == 0 && errText == "" {
		<p class="text-sm text-white/40 font-mono">No episodes found.</p>
	}
	if len(episodes) > 0 {
		<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
			for _, ep := range episodes {
				@episodeCard(ep)
			}
		</div>
	}
}

// DownloadForm is the body of the download-options modal. It is loaded into
// #download-modal-content by GET /downloads/new, and posts to /downloads. On a
// validation error the server re-renders this same template with errs (HTTP 422)
// so the dialog stays open and shows the errors; on success it returns an empty
// body + an HX-Trigger that closes the modal and refreshes the queue.
templ DownloadForm(opts DownloadFormOpts, errs map[string]string) {
	<form
		hx-post="/downloads"
		hx-target="#download-modal-content"
		hx-swap="innerHTML"
		class="flex flex-col gap-4 p-6"
	>
		<input type="hidden" name="kind" value={ opts.Kind }/>
		<input type="hidden" name="id" value={ opts.ID }/>
		<div class="flex items-start justify-between gap-2">
			<h3 class="font-display text-lg font-semibold leading-tight">{ opts.Summary }</h3>
			<button
				class="btn btn-ghost btn-sm btn-square rounded-full"
				type="button"
				onclick="document.getElementById('download-modal').close()"
				aria-label="Close"
			>
				@iconClose("h-4 w-4")
			</button>
		</div>
		if errs["_"] != "" {
			@Alert("error", errs["_"])
		}
		<div class="grid grid-cols-2 gap-3">
			<label class="form-control">
				<span class="label-text mb-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-white/45">Video quality</span>
				<select name="videoQuality" class="select select-bordered rounded-field bg-base-200 border-white/10">
					<option value="1080p" selected?={ opts.VideoQuality == "1080p" }>1080p</option>
					<option value="720p" selected?={ opts.VideoQuality == "720p" }>720p</option>
					<option value="480p" selected?={ opts.VideoQuality == "480p" }>480p</option>
					<option value="360p" selected?={ opts.VideoQuality == "360p" }>360p</option>
				</select>
			</label>
			<label class="form-control">
				<span class="label-text mb-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-white/45">Audio quality</span>
				<select name="audioQuality" class="select select-bordered rounded-field bg-base-200 border-white/10">
					<option value="192k" selected?={ opts.AudioQuality == "192k" }>192k</option>
					<option value="128k" selected?={ opts.AudioQuality == "128k" }>128k</option>
					<option value="96k" selected?={ opts.AudioQuality == "96k" }>96k</option>
				</select>
			</label>
		</div>
		<div class="form-control">
			<span class="label-text mb-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-white/45">Audio languages</span>
			<div class="flex flex-wrap gap-1.5">
				for _, l := range commonAudioLocales {
					<label class="label cursor-pointer gap-2 rounded-field px-2.5 py-1.5 bg-base-200 border border-white/10">
						<input
							type="checkbox"
							name="audioLangs"
							value={ l }
							class="checkbox checkbox-primary checkbox-sm"
							checked?={ containsString(opts.SelectedAudio, l) }
						/>
						<span class="label-text font-mono text-xs">{ l }</span>
					</label>
				}
			</div>
			if errs["audio"] != "" {
				<p class="text-error text-xs mt-1">{ errs["audio"] }</p>
			}
		</div>
		<div class="form-control">
			<span class="label-text mb-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-white/45">Subtitle languages</span>
			<div class="flex flex-wrap gap-1.5">
				for _, l := range commonSubLocales {
					<label class="label cursor-pointer gap-2 rounded-field px-2.5 py-1.5 bg-base-200 border border-white/10">
						<input
							type="checkbox"
							name="subsLangs"
							value={ l }
							class="checkbox checkbox-primary checkbox-sm"
							checked?={ containsString(opts.SelectedSubs, l) }
						/>
						<span class="label-text font-mono text-xs">{ l }</span>
					</label>
				}
			</div>
		</div>
		<div class="grid grid-cols-2 gap-3">
			<label class="form-control">
				<span class="label-text mb-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-white/45">File format</span>
				<select name="format" class="select select-bordered rounded-field bg-base-200 border-white/10">
					<option value="mkv" selected?={ opts.Format == "mkv" }>.mkv</option>
					<option value="mp4" selected?={ opts.Format == "mp4" }>.mp4</option>
				</select>
			</label>
			<label class="form-control">
				<span class="label-text mb-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-white/45">Output directory</span>
				<input
					type="text"
					name="outputDir"
					class="input input-bordered rounded-field font-mono bg-base-200 border-white/10"
					value={ opts.OutputDir }
					placeholder="."
				/>
			</label>
		</div>
		<div class="modal-action">
			<button class="btn btn-primary rounded-full gap-1.5">
				@iconDownload("h-4 w-4")
				<span>Download</span>
			</button>
		</div>
	</form>
}

// JobsPage renders the jobs panel: a header with Refresh and "Cancel all", plus
// the current job cards grouped into status sections (Queued / Downloading /
// Completed / Errors). The live updates are driven by the single multiplexed
// /jobs/events stream wired in Layout (one EventSource for the whole page), so
// this page carries no per-card script. #jobs-list carries data-jobs-url so
// refreshJobs (after a cancel/restart or a tab refocus) re-fetches the sections
// view rather than a default endpoint.
templ JobsPage(js []*jobs.Job) {
	@Layout("Jobs", "jobs") {
		<div class="flex flex-col gap-3">
			<div class="flex items-center justify-between gap-2">
				@eyebrowInline("Jobs")
				<div class="flex items-center gap-2">
					<button
						class="btn btn-ghost btn-sm rounded-full gap-1.5"
						hx-post="/jobs/cancel-all"
						hx-swap="none"
						hx-confirm="Cancel all running and queued downloads?"
						title="Cancel every running and queued download"
					>
						@iconCancel("h-4 w-4")
						<span>Cancel all</span>
					</button>
					<button class="btn btn-ghost btn-sm rounded-full gap-1.5" hx-get="/jobs/list" hx-target="#jobs-list">
						@iconGear("h-4 w-4")
						<span>Refresh</span>
					</button>
				</div>
			</div>
			<div id="jobs-list" class="atv-card rounded-box px-5 py-2" data-jobs-url="/jobs/list">
				@JobsListSections(js)
			</div>
		</div>
	}
}

// JobsListSections is the HTMX partial swapped into #jobs-list by /jobs/list. It
// groups every job into status sections in a fixed order — Queued, Downloading
// (downloading + muxing), Completed (done), Errors (error + cancelled) — each
// shown only when non-empty with an English header and count. Within a section
// the manager's insertion order is preserved. Each card still carries its
// "Series · S##E##" eyebrow, so dropping the old season group headers loses no
// context. This is the Jobs page's full history view (terminal jobs included).
templ JobsListSections(js []*jobs.Job) {
	if len(js) == 0 {
		@emptyState("No jobs yet — start a download to see it here.")
	}
	for _, sec := range jobSections(js) {
		<div class="flex items-center gap-2 pt-3 first:pt-1">
			<span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-white/45">{ sec.Title }</span>
			<span class="font-mono text-[11px] text-white/30">{ fmt.Sprintf("%d", len(sec.Jobs)) }</span>
		</div>
		for _, j := range sec.Jobs {
			@jobCard(j)
		}
	}
}

// JobsQueue is the active-only HTMX partial for a Browse "Now downloading" panel
// (view=queue): only queued / downloading / muxing jobs, so Browse stays a live
// activity surface rather than a full history. Jobs of one season/series share a
// GroupID (enqueued contiguously), so a section header (the GroupLabel) is
// rendered whenever the GroupID changes between consecutive active jobs.
templ JobsQueue(js []*jobs.Job) {
	{{ active := activeJobs(js) }}
	if len(active) == 0 {
		@emptyState("No active downloads.")
	}
	for _, row := range jobsRows(active) {
		if row.Group != "" {
			<div class="flex items-center gap-2 pt-3 first:pt-1">
				<span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-white/45">{ row.Group }</span>
			</div>
		}
		if row.Job != nil {
			@jobCard(row.Job)
		}
	}
}

// jobSection is one status section of the Jobs page: a header title and the jobs
// that belong to it, in insertion order.
type jobSection struct {
	Title string
	Jobs  []*jobs.Job
}

// jobSections groups jobs into the fixed status sections the Jobs page shows, in
// order: Queued, Downloading (downloading + muxing), Completed (done), Errors
// (error + cancelled). Empty sections are omitted. Each section preserves the
// manager's insertion order (manager.List is already insertion-ordered).
func jobSections(js []*jobs.Job) []jobSection {
	var queued, downloading, completed, errors []*jobs.Job
	for _, j := range js {
		switch j.Status() {
		case jobs.StatusQueued:
			queued = append(queued, j)
		case jobs.StatusDownloading, jobs.StatusMuxing:
			downloading = append(downloading, j)
		case jobs.StatusDone:
			completed = append(completed, j)
		case jobs.StatusError, jobs.StatusCancelled:
			errors = append(errors, j)
		}
	}
	out := make([]jobSection, 0, 4)
	if len(queued) > 0 {
		out = append(out, jobSection{Title: "Queued", Jobs: queued})
	}
	if len(downloading) > 0 {
		out = append(out, jobSection{Title: "Downloading", Jobs: downloading})
	}
	if len(completed) > 0 {
		out = append(out, jobSection{Title: "Completed", Jobs: completed})
	}
	if len(errors) > 0 {
		out = append(out, jobSection{Title: "Errors", Jobs: errors})
	}
	return out
}

// activeJobs filters the list to non-terminal jobs (queued / downloading / muxing),
// the set the Browse "Now downloading" panel shows.
func activeJobs(js []*jobs.Job) []*jobs.Job {
	var out []*jobs.Job
	for _, j := range js {
		switch j.Status() {
		case jobs.StatusQueued, jobs.StatusDownloading, jobs.StatusMuxing:
			out = append(out, j)
		}
	}
	return out
}

// jobRow is one row in the active jobs queue: either a group header (Group != "")
// or a job card (Job != nil).
type jobRow struct {
	Group string // group label to render as a section header; empty if this is a job card
	Job   *jobs.Job
}

// jobsRows flattens the job list into render rows, inserting a group header
// whenever the GroupID changes between consecutive jobs. Enqueue order keeps a
// season/series's episodes contiguous, so this yields one header per season.
func jobsRows(js []*jobs.Job) []jobRow {
	var rows []jobRow
	prev := ""
	for _, j := range js {
		if j.GroupID != "" && j.GroupID != prev {
			prev = j.GroupID
			label := j.GroupLabel
			if label == "" {
				label = "Downloads"
			}
			rows = append(rows, jobRow{Group: label})
		}
		rows = append(rows, jobRow{Job: j})
	}
	return rows
}