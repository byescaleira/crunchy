package web

import (
	"fmt"

	"crunchyroll-downloader/internal/jobs"
	"crunchyroll-downloader/internal/media"
)

// SettingsPage renders the etp-rt settings card. saved indicates a verified
// token is on file; errText shows a token/transport error from the last save.
templ SettingsPage(saved bool, errText string) {
	@Layout("Settings", "settings") {
		<div class="card bg-base-100 shadow border border-base-300">
			<div class="card-body gap-4">
				<h2 class="card-title">Settings</h2>
				<p class="text-sm text-base-content/70">
					Paste your <code>etp_rt</code> cookie. It stays on this machine
					(127.0.0.1) and is never logged.
				</p>
				<form hx-post="/settings" hx-target="#settings-result" class="flex flex-col gap-3">
					<label class="form-control">
						<span class="label-text mb-1">etp_rt cookie</span>
						<input
							type="password"
							name="etpRt"
							class="input input-bordered w-full"
							placeholder="etp_rt value"
						/>
					</label>
					<button class="btn btn-primary self-start">Save &amp; test token</button>
				</form>
				<div id="settings-result">
					if errText != "" {
						@Alert("error", errText)
					} else if saved {
						@Alert("success", "Token saved and verified.")
					}
				</div>
			</div>
		</div>
	}
}

// BrowsePage renders the browse panel: a series-URL form whose seasons partial
// targets #seasons, an #episodes panel that a season card fills via HTMX, and
// a #download-queue panel that self-loads the current jobs and refreshes when a
// download is submitted (the modal's downloadsUpdated event triggers "refresh").
templ BrowsePage(seasons []media.Season, seriesURL string, errText string) {
	@Layout("Browse", "browse") {
		<div class="grid gap-4 md:grid-cols-2">
			<div class="card bg-base-100 shadow border border-base-300">
				<div class="card-body gap-3">
					<h2 class="card-title">Browse a series</h2>
					<form hx-post="/browse" hx-target="#seasons" class="flex flex-col gap-3">
						<input
							type="text"
							name="url"
							class="input input-bordered w-full"
							placeholder="https://www.crunchyroll.com/series/..."
							value={ seriesURL }
						/>
						<button class="btn btn-primary self-start">List seasons</button>
					</form>
					<div id="seasons" class="flex flex-col gap-2">
						@SeasonsList(seasons, "", errText)
					</div>
				</div>
			</div>
			<div class="card bg-base-100 shadow border border-base-300">
				<div class="card-body gap-2">
					<h2 class="card-title">Episodes</h2>
					<div id="episodes" class="flex flex-col gap-2">
						<p class="text-sm text-base-content/50">Select a season to list its episodes.</p>
					</div>
				</div>
			</div>
		</div>
		<div class="mt-4">
			<h2 class="card-title mb-2">Download jobs</h2>
			<div
				id="download-queue"
				hx-get="/jobs/list"
				hx-trigger="load, refresh"
				hx-target="this"
				hx-swap="innerHTML"
			>
				<p class="text-sm text-base-content/50">No jobs yet — start a download from an episode.</p>
			</div>
		</div>
	}
}

// SeasonsList is the HTMX partial swapped into #seasons after a /browse POST.
// seriesID (the parsed series content id) is carried so a "Download entire
// series" button can be rendered above the season cards; it's empty before the
// user lists a series.
templ SeasonsList(seasons []media.Season, seriesID, errText string) {
	if errText != "" {
		@Alert("error", errText)
	}
	if len(seasons) == 0 && errText == "" {
		<p class="text-sm text-base-content/50">No seasons yet — paste a series URL above.</p>
	}
	if len(seasons) > 0 && seriesID != "" {
		<div class="flex items-center justify-between gap-2 pb-1">
			<span class="text-sm text-base-content/70">{ fmt.Sprintf("%v seasons", len(seasons)) }</span>
			@DownloadButton("series", seriesID)
		</div>
	}
	for _, s := range seasons {
		@seasonCard(s)
	}
}

// EpisodesTable is the HTMX partial swapped into #episodes when a season is
// selected. Each row carries a per-episode Download button that opens the
// download-options modal; the option fields themselves live in the modal.
templ EpisodesTable(episodes []media.SeasonEpisode, errText string) {
	if errText != "" {
		@Alert("error", errText)
	}
	if len(episodes) == 0 && errText == "" {
		<p class="text-sm text-base-content/50">No episodes found.</p>
	}
	if len(episodes) > 0 {
		<div class="overflow-x-auto">
			<table class="table table-zebra">
				<thead>
					<tr><th>#</th><th>Title</th><th>Audio</th><th></th></tr>
				</thead>
				<tbody>
					for _, ep := range episodes {
						@episodeRow(ep)
					}
				</tbody>
			</table>
		</div>
	}
}

// DownloadForm is the body of the download-options modal. It is loaded into
// #download-modal-content by GET /downloads/new, and posts to /downloads. On a
// validation error the server re-renders this same template with errs (HTTP 422)
// so the dialog stays open and shows the errors; on success it returns an empty
// body + an HX-Trigger that closes the modal and refreshes the queue.
//
// opts carries the chosen values (so they survive a 422 re-render); errs maps a
// field name (or "_") to a message.
templ DownloadForm(opts DownloadFormOpts, errs map[string]string) {
	<form
		hx-post="/downloads"
		hx-target="#download-modal-content"
		hx-swap="innerHTML"
		class="flex flex-col gap-4"
	>
		<input type="hidden" name="kind" value={ opts.Kind }/>
		<input type="hidden" name="id" value={ opts.ID }/>
		<h3 class="text-lg font-bold">{ opts.Summary }</h3>
		if errs["_"] != "" {
			@Alert("error", errs["_"])
		}
		<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
			<label class="form-control">
				<span class="label-text mb-1">Video quality</span>
				<select name="videoQuality" class="select select-bordered">
					<option value="1080p" selected?={ opts.VideoQuality == "1080p" }>1080p</option>
					<option value="720p" selected?={ opts.VideoQuality == "720p" }>720p</option>
					<option value="480p" selected?={ opts.VideoQuality == "480p" }>480p</option>
					<option value="360p" selected?={ opts.VideoQuality == "360p" }>360p</option>
				</select>
			</label>
			<label class="form-control">
				<span class="label-text mb-1">Audio quality</span>
				<select name="audioQuality" class="select select-bordered">
					<option value="192k" selected?={ opts.AudioQuality == "192k" }>192k</option>
					<option value="128k" selected?={ opts.AudioQuality == "128k" }>128k</option>
					<option value="96k" selected?={ opts.AudioQuality == "96k" }>96k</option>
				</select>
			</label>
		</div>
		<div class="form-control">
			<span class="label-text mb-1">Audio languages</span>
			<div class="flex flex-wrap gap-2">
				for _, l := range commonAudioLocales {
					<label class="label cursor-pointer gap-1 border border-base-300 rounded px-2 py-1">
						<input
							type="checkbox"
							name="audioLangs"
							value={ l }
							class="checkbox checkbox-primary checkbox-sm"
							checked?={ containsString(opts.SelectedAudio, l) }
						/>
						<span class="label-text">{ l }</span>
					</label>
				}
			</div>
			if errs["audio"] != "" {
				<p class="text-error text-xs mt-1">{ errs["audio"] }</p>
			}
		</div>
		<div class="form-control">
			<span class="label-text mb-1">Subtitle languages</span>
			<div class="flex flex-wrap gap-2">
				for _, l := range commonSubLocales {
					<label class="label cursor-pointer gap-1 border border-base-300 rounded px-2 py-1">
						<input
							type="checkbox"
							name="subsLangs"
							value={ l }
							class="checkbox checkbox-primary checkbox-sm"
							checked?={ containsString(opts.SelectedSubs, l) }
						/>
						<span class="label-text">{ l }</span>
					</label>
				}
			</div>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
			<label class="form-control">
				<span class="label-text mb-1">File format</span>
				<select name="format" class="select select-bordered">
					<option value="mkv" selected?={ opts.Format == "mkv" }>.mkv (Matroska)</option>
					<option value="mp4" selected?={ opts.Format == "mp4" }>.mp4 (MP4)</option>
				</select>
			</label>
			<label class="form-control">
				<span class="label-text mb-1">Output directory</span>
				<input
					type="text"
					name="outputDir"
					class="input input-bordered w-full"
					value={ opts.OutputDir }
					placeholder="."
				/>
			</label>
		</div>
		<div class="modal-action">
			<button class="btn btn-ghost" type="button" onclick="document.getElementById('download-modal').close()">
				Cancel
			</button>
			<button class="btn btn-primary">Download</button>
		</div>
	</form>
}

// JobsPage renders the jobs panel: a refresh button that re-pulls the jobs list
// into #jobs-list, plus the current job cards.
templ JobsPage(js []*jobs.Job) {
	@Layout("Jobs", "jobs") {
		<div class="flex flex-col gap-3">
			<div class="flex items-center justify-between">
				<h2 class="card-title">Jobs</h2>
				<button class="btn btn-ghost btn-sm" hx-get="/jobs/list" hx-target="#jobs-list">Refresh</button>
			</div>
			<div id="jobs-list" class="flex flex-col gap-2">
				@JobsList(js)
			</div>
		</div>
		<script>
			(function () {
				document.querySelectorAll("[data-job-sse]").forEach(function (card) {
					var id = card.getAttribute("data-job-sse");
					var es = new EventSource("/jobs/" + id + "/events");
					es.addEventListener("segment", function (e) {
						var d = JSON.parse(e.data);
						var box = document.getElementById("job-" + id + "-progress");
						var bar = box && box.querySelector("progress");
						if (bar && d.total > 0) {
							bar.value = (d.done * 100) / d.total;
						}
					});
					es.addEventListener("status", function (e) {
						var d = JSON.parse(e.data);
						var badge = document.getElementById("job-" + id + "-status");
						if (badge) {
							badge.textContent = d.status;
							badge.className = "badge " + ({
								queued: "badge-ghost",
								downloading: "badge-warning",
								muxing: "badge-info",
								done: "badge-success",
								error: "badge-error"
							}[d.status] || "badge-ghost");
						}
						if (d.status === "error") {
							var err = document.getElementById("job-" + id + "-error");
							if (err && d.message) {
								err.innerHTML = '<div class="text-xs text-error font-mono break-all"></div>';
								err.firstChild.textContent = d.message;
							}
						}
					});
					es.addEventListener("done", function () {
						es.close();
					});
					es.addEventListener("error", function () {
						es.close();
					});
				});
			})();
		</script>
	}
}

// jobsList is the HTMX partial swapped into #jobs-list by /jobs (GET) and the
// refresh button.
templ JobsList(js []*jobs.Job) {
	if len(js) == 0 {
		<p class="text-sm text-base-content/50">No jobs yet.</p>
	}
	for _, j := range js {
		@jobCard(j)
	}
}