package web

// Layout is the page chrome shared by every page: the DaisyUI data-theme
// container (dark-only "appletv"), the compiled app.css and htmx.min.js (served
// from the embedded static FS), the translucent glass top bar, the shared
// download-options modal shell, and the multiplex-SSE + modal-event scripts.
// Pages pass their body as children via @Layout(...) { ... }.
templ Layout(title, active string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="appletv">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } · Crunchy Downloader</title>
			<link rel="icon" href="/static/favicon/favicon.ico" sizes="any"/>
			<link rel="icon" href="/static/favicon/favicon-32x32.png" type="image/png" sizes="32x32"/>
			<link rel="icon" href="/static/favicon/favicon-16x16.png" type="image/png" sizes="16x16"/>
			<link rel="apple-touch-icon" href="/static/favicon/apple-touch-icon.png"/>
			<link rel="manifest" href="/static/favicon/site.webmanifest"/>
			<meta name="theme-color" content="#0b0b0e"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body class="min-h-screen bg-base-200 text-base-content">
			@navbar(active)
			<main class="container mx-auto p-4 max-w-6xl">
				{ children... }
			</main>
			@DownloadModalShell()
			<script>
				// One multiplexed /jobs/events stream drives every job card on the
				// page (Browse queue, Jobs page). Each SSE event carries the job id
				// so the handlers dispatch to the matching card. The server sends a
				// snapshot on connect (and on every EventSource reconnect), so a late
				// or reconnected client catches up to the current state.
				(function () {
					if (window.__crdlJobs) { return; }
					window.__crdlJobs = true;
					// autoFired tracks which jobs we've already auto-downloaded so a
					// flaky EventSource reconnect (which re-sends a snapshot) can't
					// trigger a second download of the same file. Cleared per page load.
					var autoFired = {};
					// downloadFile triggers a browser download of a job's output file
					// (the phone's "auto-download on completion" path) and injects a
					// visible Baixar button into the card so the user can retry by hand
					// if the automatic download is blocked (iOS Safari often blocks
					// programmatic downloads outside a user gesture). The server only
					// sends file/url on a done event for remote subscribers, so this
					// never fires on the host (the Mac keeps its file, no popup).
					function downloadFile(id, file, url) {
						if (autoFired[id]) { return; }
						autoFired[id] = true;
						var a = document.createElement("a");
						a.href = url;
						a.download = file || "";
						a.style.display = "none";
						document.body.appendChild(a);
						a.click();
						setTimeout(function () { if (a.parentNode) { document.body.removeChild(a); } }, 1000);
						injectBaixar(id, file, url);
					}
					// injectBaixar adds a Baixar button to the card's terminal control
					// group so a live-watched job (rendered while still running, before
					// the server-rendered button would exist) still gets a fallback grab
					// link once it completes. Idempotent per card.
					function injectBaixar(id, file, url) {
						var card = document.getElementById("job-" + id);
						if (!card) { return; }
						var group = card.querySelector('[data-controls="terminal"]');
						if (!group || group.querySelector('[data-baixar]')) { return; }
						var a = document.createElement("a");
						a.setAttribute("data-baixar", "1");
						a.className = "btn btn-ghost btn-xs rounded-full gap-1 text-white/70 hover:text-primary";
						a.href = url;
						a.download = file || "";
						a.title = "Baixar o arquivo para este dispositivo";
						a.innerHTML = "<span>Baixar</span>";
						group.insertBefore(a, group.firstChild);
					}
					var dotColor = {
						queued: "bg-white/25",
						downloading: "bg-primary",
						muxing: "bg-primary",
						done: "bg-success",
						error: "bg-error",
						cancelled: "bg-white/30"
					};
					var badgeClass = {
						queued: "badge-ghost",
						downloading: "badge-primary",
						muxing: "badge-info",
						done: "badge-success",
						error: "badge-error",
						cancelled: "badge-ghost"
					};
					var PHASES = ["subtitles", "audio", "video", "mux"];
					var PHASE_LABELS = {
						subtitles: "Fetching subtitles",
						audio: "Downloading audio",
						video: "Downloading segments",
						mux: "Converting"
					};
					var CHIP_BASE = "inline-flex items-center px-1.5 py-0.5 rounded-field font-mono text-[10px] uppercase tracking-wider border transition-colors ";
					var CHIP_DONE = "border-primary/30 text-primary/80 bg-primary/10";
					var CHIP_ACTIVE = "border-primary text-primary-content bg-primary";
					var CHIP_PENDING = "border-white/10 text-white/35";
					var phase = {};

					function chipClass(state) {
						if (state === "done") { return CHIP_BASE + CHIP_DONE; }
						if (state === "active") { return CHIP_BASE + CHIP_ACTIVE; }
						return CHIP_BASE + CHIP_PENDING;
					}
					function renderRail(id, ph) {
						var idx = PHASES.indexOf(ph);
						for (var i = 0; i < PHASES.length; i++) {
							var chip = document.getElementById("job-" + id + "-chip-" + PHASES[i]);
							if (!chip) { continue; }
							var state = "pending";
							if (idx >= 0) {
								if (i < idx) { state = "done"; }
								else if (i === idx) { state = "active"; }
							}
							chip.className = chipClass(state);
						}
					}
					function renderRailDone(id) {
						for (var i = 0; i < PHASES.length; i++) {
							var chip = document.getElementById("job-" + id + "-chip-" + PHASES[i]);
							if (chip) { chip.className = chipClass("done"); }
						}
					}
					function setPct(id, pct) {
						var box = document.getElementById("job-" + id + "-progress");
						var bar = box && box.querySelector("progress");
						if (bar) { bar.value = pct; }
						var span = document.getElementById("job-" + id + "-pct");
						if (span) { span.textContent = pct + "%"; }
					}
					function applyStatus(id, status, message) {
						var badge = document.getElementById("job-" + id + "-status");
						if (badge) {
							badge.textContent = status;
							badge.className = "badge " + (badgeClass[status] || "badge-ghost") + " badge-sm font-mono shrink-0 ml-auto";
						}
						var dot = document.getElementById("job-" + id + "-dot");
						if (dot) {
							dot.className = "inline-block h-2 w-2 rounded-full shrink-0 " + (dotColor[status] || "bg-white/25");
						}
						// Toggle the per-card control buttons for the new status:
						//   running (queued/downloading/muxing) shows Cancel;
						//   terminal (done/error/cancelled) shows Restart + Delete.
						var card = document.getElementById("job-" + id);
						if (card) {
							var running = card.querySelector("[data-controls='running']");
							var terminal = card.querySelector("[data-controls='terminal']");
							var isTerminal = status === "done" || status === "error" || status === "cancelled";
							if (running) { running.style.display = isTerminal ? "none" : ""; }
							if (terminal) { terminal.style.display = isTerminal ? "" : "none"; }
						}
						if (status === "error") {
							var err = document.getElementById("job-" + id + "-error");
							if (err && message) {
								err.innerHTML = '<div class="text-xs text-error font-mono break-all"></div>';
								err.firstChild.textContent = message;
							}
						}
					}

					var es = new EventSource("/jobs/events");
					es.addEventListener("phase", function (e) {
						var d = JSON.parse(e.data);
						phase[d.id] = d.phase || "";
						var label = document.getElementById("job-" + d.id + "-phase");
						if (label) { label.textContent = PHASE_LABELS[d.phase] || d.phase; }
						renderRail(d.id, d.phase);
					});
					es.addEventListener("segment", function (e) {
						var d = JSON.parse(e.data);
						var pct = d.total > 0 ? Math.round((d.done * 100) / d.total) : 0;
						setPct(d.id, pct);
						if (phase[d.id]) { renderRail(d.id, phase[d.id]); }
					});
					es.addEventListener("status", function (e) {
						var d = JSON.parse(e.data);
						applyStatus(d.id, d.status, d.message);
					});
					es.addEventListener("done", function (e) {
						var d = JSON.parse(e.data);
						applyStatus(d.id, d.status, d.message);
						setPct(d.id, 100);
						if (d.status !== "error" && d.status !== "cancelled") { renderRailDone(d.id); }
						var label = document.getElementById("job-" + d.id + "-phase");
						if (label) {
							label.textContent = d.status === "error" ? "Failed" : (d.status === "cancelled" ? "Cancelled" : "Done");
						}
						// A done event for a successful job carries the output file
						// name + grab URL only when this client is remote (the server
						// decides per-subscriber). Auto-download it to this device and
						// inject a Baixar fallback button; absent for the host.
						if (d.status === "done" && d.file && d.url) {
							downloadFile(d.id, d.file, d.url);
						}
					});
					// A removed event drops the whole card from the page (the Manager
					// deleted a terminal job). No list refresh needed.
					es.addEventListener("removed", function (e) {
						var d = JSON.parse(e.data);
						var card = document.getElementById("job-" + d.id);
						if (card) { card.remove(); }
					});
					// EventSource auto-reconnects on error; the server re-sends a
					// snapshot on reconnect so state catches up. Nothing to do here.
					es.addEventListener("error", function () {});
				})();
			</script>
			<script>
				// The download flow drives the modal with two HX-Trigger events
				// (set by the POST /downloads response header):
				//   closeDownloadModal — close the dialog and clear stale form state
				//   downloadsUpdated   — refresh the #download-queue partial
				// htmx dispatches HX-Trigger events on the requesting element; they
				// bubble to document, so a document-level listener always catches them.
				document.addEventListener("closeDownloadModal", function () {
					var d = document.getElementById("download-modal");
					if (d && d.open) {
						d.close();
					}
					var c = document.getElementById("download-modal-content");
					if (c) {
						c.replaceChildren();
					}
				});
				document.addEventListener("downloadsUpdated", function () {
					if (window.htmx) {
						htmx.trigger("#download-queue", "refresh");
					}
				});
				// refreshJobs re-fetches the jobs partial into whichever jobs container
				// is present (#download-queue on Browse, #jobs-list on Jobs). The URL is
				// read from the container's data-jobs-url attribute so each page refreshes
				// its own view (Jobs → the status sections, Browse → the active queue),
				// falling back to /jobs/list. It is the authoritative snapshot of every
				// job's current status/progress, so it is used both after a per-card
				// cancel/delete/restart (jobsChanged) and when the tab becomes visible
				// again (visibilitychange) — see below.
				function refreshJobs() {
					if (!window.htmx) { return; }
					var t = document.getElementById("download-queue") || document.getElementById("jobs-list");
					if (t) {
						var url = t.getAttribute("data-jobs-url") || "/jobs/list";
						htmx.ajax("GET", url, { target: t, swap: "innerHTML" });
					}
				}
				// jobsChanged is fired by the per-card cancel/delete/restart handlers.
				document.addEventListener("jobsChanged", refreshJobs);
				// When the tab is backgrounded, the browser throttles the EventSource
				// delivery + the JS event loop, so the live progress bar freezes even
				// though the server-side downloads keep running. On return, instead of
				// waiting for the throttled live events to flush, snap straight to the
				// server's authoritative state — the bar jumps to where the download
				// actually is, confirming it never stopped.
				document.addEventListener("visibilitychange", function () {
					if (!document.hidden) {
						refreshJobs();
					}
				});
			</script>
			<div id="toast-container" class="toast toast-top toast-end z-50"></div>
			<script>
				// Toast on download start + active-jobs nav badge + browse-state
				// restore. None of this round-trips to the server — it is all
				// client-side state layered on the existing multiplexed SSE stream.
				(function () {
					// --- Toast ---------------------------------------------------------
					// jobStarted is fired by the POST /downloads HX-Trigger header with
					// {title: <episode label | "N downloads queued">}. Show a success
					// toast and stay on the page the user enqueued from.
					var toastBox = document.getElementById("toast-container");
					function showToast(msg) {
						if (!toastBox) { return; }
						var el = document.createElement("div");
						el.className = "alert alert-success shadow-lg atv-glass rounded-box border border-white/10 py-2 px-3 text-sm";
						el.innerHTML =
							'<span class="inline-flex items-center gap-2">' +
							'<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>' +
							'<span class="toast-msg"></span></span>';
						el.querySelector(".toast-msg").textContent = msg;
						toastBox.appendChild(el);
						setTimeout(function () {
							el.classList.add("opacity-0", "transition-opacity", "duration-300");
							setTimeout(function () { el.remove(); }, 320);
						}, 3200);
					}
					document.addEventListener("jobStarted", function (e) {
						var title = (e.detail && e.detail.title) || "Download started";
						showToast("Download started — " + title);
					});

					// --- Active-jobs nav badge -----------------------------------------
					// Maintain the set of non-terminal job ids from the multiplexed SSE
					// stream and reflect its size on the Jobs pill. The snapshot on
					// connect seeds it, so no extra request is needed.
					var navJobs = document.getElementById("nav-jobs");
					var navCount = null;
					if (navJobs) {
						navCount = document.createElement("span");
						navCount.id = "nav-jobs-count";
						navCount.className = "badge badge-sm badge-primary crdl-badge-blink ml-2 hidden";
						navCount.textContent = "0";
						navJobs.appendChild(navCount);
					}
					var active = {};
					function syncBadge() {
						if (!navCount) { return; }
						var n = 0;
						for (var k in active) { if (active.hasOwnProperty(k)) { n++; } }
						navCount.textContent = String(n);
						navCount.classList.toggle("hidden", n === 0);
					}
					function isActive(status) {
						return status === "queued" || status === "downloading" || status === "muxing";
					}
					function trackStatus(id, status) {
						if (isActive(status)) { active[id] = true; }
						else { delete active[id]; }
						syncBadge();
					}
					// The multiplexed EventSource is created in the first script block.
					// It is not reachable by name from here, so attach a second
					// EventSource on the same stream purely to drive the badge (the
					// server's snapshot+live events keep it in sync).
					var badgeEs = new EventSource("/jobs/events");
					badgeEs.addEventListener("status", function (e) {
						var d = JSON.parse(e.data);
						trackStatus(d.id, d.status);
					});
					badgeEs.addEventListener("done", function (e) {
						var d = JSON.parse(e.data);
						trackStatus(d.id, d.status);
					});
					badgeEs.addEventListener("removed", function (e) {
						var d = JSON.parse(e.data);
						delete active[d.id];
						syncBadge();
					});
					badgeEs.addEventListener("error", function () {});

					// --- Browse-state restore ------------------------------------------
					// The nav is full-page links, so leaving Browse to Jobs/Settings
					// drops the series/search the user was on. Persist the last browse
					// URL and, when on Jobs/Settings, point the Browse pill at it
					// instead of /browse (popular). On browse pages the
					// server-rendered href stays /browse so the pill still goes to
					// popular while browsing.
					var LAST_KEY = "crdl.browse.last";
					var path = location.pathname;
					var isBrowse = path === "/browse" || path.indexOf("/series/") === 0;
					if (isBrowse) {
						try {
							localStorage.setItem(LAST_KEY, path + location.search);
						} catch (x) {}
					}
					if (path === "/jobs" || path === "/settings") {
						var last = null;
						try { last = localStorage.getItem(LAST_KEY); } catch (x) {}
						var navBrowse = document.getElementById("nav-browse");
						if (last && navBrowse) { navBrowse.href = last; }
					}
					// Expanded-season restore: if the series page reloaded with a
					// previously-expanded season, re-fetch its episodes into #episodes.
					if (path.indexOf("/series/") === 0 && window.htmx) {
						var eps = document.getElementById("episodes");
						if (eps && eps.dataset.seriesId) {
							var sk = "crdl.browse.season." + eps.dataset.seriesId;
							var seasonId = null;
							try { seasonId = localStorage.getItem(sk); } catch (x) {}
							if (seasonId) {
								htmx.ajax("GET", "/season/" + encodeURIComponent(seasonId) + "/episodes", { target: "#episodes", swap: "innerHTML" });
							}
							// Remember which season a View click expanded.
							document.addEventListener("click", function (ev) {
								var btn = ev.target.closest("[data-season-id]");
								if (!btn) { return; }
								try {
									localStorage.setItem("crdl.browse.season." + eps.dataset.seriesId, btn.dataset.seasonId);
								} catch (x) {}
							});
						}
					}
				})();
			</script>
		</body>
	</html>
}

// DownloadModalShell is the shared, always-present native <dialog> that the
// download buttons populate. It stays empty until a button does hx-get into
// #download-modal-content and then calls showModal() after the swap. The
// backdrop <form method="dialog"> makes the modal closeable without JS (ESC and
// backdrop click both work natively).
templ DownloadModalShell() {
	<dialog id="download-modal" class="modal">
		<div class="modal-box atv-glass rounded-box border border-white/10 shadow-2xl">
			<div
				id="download-modal-content"
				hx-on::after-swap="if(this.querySelector('form')){var d=document.getElementById('download-modal');if(d&&!d.open){d.showModal();}}"
			></div>
		</div>
		<form method="dialog" class="modal-backdrop bg-black/70">
			<button>close</button>
		</form>
	</dialog>
}

// navbar is the floating liquid-glass capsule Apple uses for its top tab bar: a
// centered rounded-full glass pill that floats with a margin from the top/sides
// (not a full-width bar), a faint full border, and a soft drop shadow. The brand
// mark + section pills sit on the left, the search field sits on the right. The
// search is a plain GET form to /browse — a single text input submits on Enter
// with no button, so there is no Search button to tap. Dark-only — no theme toggle.
templ navbar(active string) {
	<div class="sticky top-0 z-20 px-4 pt-4">
		<div class="container mx-auto max-w-6xl">
			<nav class="atv-capsule flex items-center gap-3 rounded-full pl-3 pr-2 py-2">
				<a class="flex items-center gap-2 px-1.5 shrink-0" href="/browse">
					<img src="/static/favicon/android-chrome-192x192.png" alt="Crunchy Downloader" class="h-7 w-7 shrink-0 rounded-full object-cover"/>
					<span class="font-semibold tracking-tight text-sm text-white/90 hidden md:inline">Crunchy Downloader</span>
				</a>
				<div class="flex items-center gap-1 shrink-0">
					@navLink("", "Settings", "/settings", active == "settings")
					@navLink("nav-browse", "Browse", "/browse", active == "browse")
					@navLink("nav-jobs", "Jobs", "/jobs", active == "jobs")
				</div>
				<form action="/browse" method="get" class="relative ml-auto w-full max-w-sm min-w-0">
					@iconSearch("h-4 w-4 text-white/40 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none")
					<input
						type="text"
						name="q"
						class="input input-bordered rounded-full w-full h-9 pl-10 pr-3 bg-base-200/60 border-white/10 text-sm"
						placeholder="Search by title or paste a series URL"
						autocomplete="off"
					/>
				</form>
			</nav>
		</div>
	</div>
}

// navLink is a section pill inside the capsule. The active link gets a solid
// primary fill; inactive links are quiet off-white that brighten on hover. id,
// when non-empty, lets JS target the pill (Browse gets "nav-browse", Jobs gets
// "nav-jobs" so the active-jobs badge can be appended and the Browse href can be
// rewritten to restore the last browse location); an empty id is omitted so the
// Settings pill renders no id attribute.
templ navLink(id, label, href string, active bool) {
	{{ cls := "px-4 py-1.5 text-sm font-medium text-white/55 hover:text-white rounded-full hover:bg-white/10 transition-colors"
	   if active {
	   	cls = "px-4 py-1.5 text-sm font-medium text-primary-content bg-primary rounded-full shadow-lg shadow-primary/30"
	   }
	}}
	<a class={ cls } href={ href } if id != "" { id={ id } }>{ label }</a>
}