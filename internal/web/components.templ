package web

import (
	"crunchyroll-downloader/internal/jobs"
	"crunchyroll-downloader/internal/media"
)

// Alert renders a DaisyUI alert. kind is one of error/success/warning/info.
// Exported so the server can render it standalone as an HTMX partial.
templ Alert(kind, msg string) {
	<div class={ "alert " + alertClass(kind) }>
		<span>{ msg }</span>
	</div>
}

// DownloadButton opens the download-options modal for a granularity (episode /
// season / series) and a content id. It hx-gets the form into #download-modal-content
// and calls showModal() after the swap (so the HTML is in the DOM before the
// dialog opens). Using hx-on::after-swap — not click — guarantees the form
// exists when showModal runs.
templ DownloadButton(kind, id string) {
	<button
		class="btn btn-primary btn-sm"
		hx-get={ "/downloads/new?kind=" + kind + "&id=" + id }
		hx-target="#download-modal-content"
		hx-swap="innerHTML"
		hx-on::after-swap="document.getElementById('download-modal').showModal()"
	>
		{ downloadButtonLabel(kind) }
	</button>
}

// seasonCard renders one season as a card with a button that loads its episodes
// into the #episodes target via HTMX, and a Download button that opens the
// download-options modal for the whole season (kind=season).
templ seasonCard(s media.Season) {
	<div class="card bg-base-100 shadow border border-base-300">
		<div class="card-body flex-row items-center justify-between gap-2">
			<h2 class="card-title">Season { s.SeasonNumber }</h2>
			<div class="flex gap-2">
				<button
					class="btn btn-ghost btn-sm"
					hx-get={ "/season/" + s.ID + "/episodes" }
					hx-target="#episodes"
				>View episodes</button>
				@DownloadButton("season", s.ID)
			</div>
		</div>
	</div>
}

// episodeRow renders one episode as a table row with a per-row Download button
// that opens the download-options modal for that single episode (kind=episode).
templ episodeRow(ep media.SeasonEpisode) {
	<tr>
		<td class="font-mono whitespace-nowrap">E{ ep.EpisodeNumber }</td>
		<td>{ ep.Title }</td>
		<td class="flex flex-wrap gap-1">
			for _, l := range audioLocales(ep) {
				<span class="badge badge-ghost badge-sm">{ l }</span>
			}
		</td>
		<td>@DownloadButton("episode", ep.ID)</td>
	</tr>
}

// statusBadge renders a job's status as a colored DaisyUI badge.
templ statusBadge(s jobs.Status) {
	<span class={ "badge " + statusBadgeClass(string(s)) }>{ string(s) }</span>
}

// progressBar renders a DaisyUI progress bar for a job from its last segment
// (done, total) tick. Jobs that haven't reported segments show an indeterminate
// bar.
templ progressBar(j *jobs.Job) {
	{{
		done, total := j.Segment()
		pct := 0
		if total > 0 {
			pct = done * 100 / total
		}
	}}
	if total > 0 {
		<progress class="progress progress-primary w-full" value={ pct } max="100"></progress>
	} else {
		<progress class="progress progress-primary w-full"></progress>
	}
}

// jobCard renders one job: label, status badge, progress bar, and an error line
// if it failed. The card's id lets the SSE handler target it for swaps; the
// data-job-sse attribute opts the card into the JobsPage EventSource script,
// and the progress/status element ids let that script update them live.
templ jobCard(j *jobs.Job) {
	<div class="card bg-base-100 shadow border border-base-300" id={ "job-" + j.ID } data-job-sse={ j.ID }>
		<div class="card-body gap-2">
			<div class="flex items-center justify-between gap-2">
				<h3 class="card-title text-base truncate">{ j.Label }</h3>
				<span class={ "badge " + statusBadgeClass(string(j.Status())) } id={ "job-" + j.ID + "-status" }>{ string(j.Status()) }</span>
			</div>
			<div id={ "job-" + j.ID + "-progress" }>
				@progressBar(j)
			</div>
			<div id={ "job-" + j.ID + "-error" }>
				if j.Status() == "error" {
					<div class="text-xs text-error font-mono break-all">{ j.Error() }</div>
				}
			</div>
		</div>
	</div>
}